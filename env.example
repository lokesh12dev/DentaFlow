# Mobile-safe values. Never place service-role or vendor secret keys here.
EXPO_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_REPLACE_ME
EXPO_PUBLIC_APP_ENV=production
EXPO_PUBLIC_ENABLE_DEMO_MODE=false

# Provider behavior. Falls back to native apps when unavailable.
EXPO_PUBLIC_PREFER_PROVIDER_MESSAGING=true
EXPO_PUBLIC_USE_CLOUD_TELEPHONY=false

# Supabase Edge Function secrets (set with `supabase secrets set`, never in the app).
# OPENROUTER_API_KEY=
# OPENROUTER_MODEL=
# OPENROUTER_MULTIMODAL_MODEL=
# WHATSAPP_ACCESS_TOKEN=
# WHATSAPP_PHONE_NUMBER_ID=
# META_APP_SECRET=
# WHATSAPP_VERIFY_TOKEN=
# RESEND_API_KEY=
# EMAIL_FROM=
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_FROM_NUMBER=
# TWILIO_TWIML_URL=
# TWILIO_WEBHOOK_PUBLIC_URL=
# PATIENT_PORTAL_URL=
# BOOKING_RATE_SALT=
