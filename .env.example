# DentaFlow mobile application (safe to expose in an Expo client)
EXPO_PUBLIC_APP_ENV=development
EXPO_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_REPLACE_ME
EXPO_PUBLIC_ENABLE_DEMO_MODE=true
EXPO_PUBLIC_DEMO_ROLE=owner
EXPO_PUBLIC_PREFER_PROVIDER_MESSAGING=false
EXPO_PUBLIC_USE_CLOUD_TELEPHONY=false
EXPO_PUBLIC_PATIENT_PORTAL_URL=https://portal.example.com
# EXPO_PUBLIC_SENTRY_DSN=

# Supabase Edge Function secrets (server-side only; set with `supabase secrets set`)
# SUPABASE_SERVICE_ROLE_KEY=
# OPENROUTER_API_KEY=
# OPENROUTER_MODEL=
# OPENROUTER_SITE_URL=
# WHATSAPP_ACCESS_TOKEN=
# WHATSAPP_PHONE_NUMBER_ID=
# META_APP_SECRET=
# WHATSAPP_VERIFY_TOKEN=
# RESEND_API_KEY=
# EMAIL_FROM=
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_FROM_NUMBER=
# TWILIO_WEBHOOK_PUBLIC_URL=
# PROVIDER_WEBHOOK_SECRET=
# RATE_LIMIT_SALT=
# PATIENT_PORTAL_URL=
