{
  "name": "dentaflow",
  "version": "1.0.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start --dev-client",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "prebuild": "expo prebuild --clean",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "npm run test:domain && npm run test:access && npm run test:raw-text && npm run test:icons",
    "test:raw-text": "node scripts/check-raw-text-nodes.mjs",
    "test:icons": "node scripts/check-icon-colors.mjs",
    "test:domain": "node scripts/run-domain-tests.mjs",
    "test:access": "node scripts/run-access-tests.mjs",
    "audit": "python3 scripts/run_all_audits.py",
    "verify": "npm run typecheck && npm run test:raw-text && npm run test:icons && npm run test:domain && npm run test:access && npm run audit",
    "build:preview": "eas build --platform android --profile preview",
    "build:production": "eas build --platform all --profile production",
    "supabase:start": "supabase start",
    "supabase:reset": "supabase db reset",
    "supabase:push": "supabase db push",
    "supabase:functions": "supabase functions deploy"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.2.1",
    "@expo/metro-runtime": "~57.0.2",
    "@shopify/flash-list": "2.0.2",
    "@supabase/supabase-js": "^2.55.0",
    "@tanstack/react-query": "^5.85.0",
    "date-fns": "^4.1.0",
    "expo": "~57.0.0",
    "expo-asset": "~57.0.2",
    "expo-audio": "~57.0.0",
    "expo-blur": "~57.0.0",
    "expo-constants": "~57.0.2",
    "expo-crypto": "~57.0.0",
    "expo-device": "~57.0.0",
    "expo-file-system": "~57.0.0",
    "expo-haptics": "~57.0.0",
    "expo-image-picker": "~57.0.1",
    "expo-linking": "~57.0.1",
    "expo-local-authentication": "~57.0.0",
    "expo-notifications": "~57.0.2",
    "expo-print": "~57.0.0",
    "expo-router": "~57.0.2",
    "expo-secure-store": "~57.0.0",
    "expo-sharing": "~57.0.1",
    "expo-splash-screen": "~57.0.1",
    "expo-sqlite": "~57.0.0",
    "expo-status-bar": "~57.0.0",
    "lucide-react-native": "^1.28.0",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-hook-form": "^7.62.0",
    "react-native": "0.86.2",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-svg": "15.15.4",
    "react-native-worklets": "0.10.1",
    "react-native-web": "0.21.2",
    "zod": "^4.1.0",
    "zustand": "^5.0.8"
  },
  "devDependencies": {
    "@types/react": "^19.2.0",
    "babel-preset-expo": "~57.0.1",
    "eslint": "^9.34.0",
    "eslint-config-expo": "~57.0.0",
    "typescript": "~6.0.3"
  }
}
